{
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING"
  },
  "TokenOptions": {
    "Audience": "YOUR_AUDIENCE",
    "Issuer": "YOUR_ISSUER",
    "AccessTokenExpiration": 60,
    "SecurityKey": "YOUR_SECRET_KEY"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
